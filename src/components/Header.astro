---
import { Icon } from 'astro-icon/components';
import ToggleMenu from '@/components/common/ToggleMenu.astro';
import Button from '@/components/ui/Button.astro';
import Logo from '@/components/Logo.astro';

import { getHomePermalink } from '@/utils/permalinks';
import { trimSlash } from '@/utils/permalinks';
import type { CallToAction } from '@/types';

import { twMerge } from 'tailwind-merge';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isFixed?: boolean;
}

const { id = 'header', links = [], actions = [], isSticky = false, isFixed = false } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const isHome = currentPath === '/';

const normalizePath = (path: string) => {
  return '/' + trimSlash(path.split('#')[0]);
};

const shouldUnderline = (href?: string) => {
  if (!href) return false;

  // parallax não precisa de underline pra evitar bug visual
  if (href.includes('#')) return false;

  const current = normalizePath(currentPath);
  const target = normalizePath(href);

  // Home
  if (target === '/') {
    return current === '/';
  }

  // Path exato ou sub-rota
  return current === target || current.startsWith(target + '/');
};
const getDropdownToken = (text: string, index: number) => {
  const normalizedText = text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

  return normalizedText || `item-${index}`;
};

const getDropdownIds = (text = '', index: number) => {
  const token = getDropdownToken(text, index);

  return {
    triggerId: `header-dropdown-trigger-${token}-${index}`,
    menuId: `header-dropdown-menu-${token}-${index}`,
  };
};
---

<header
  class:list={[
    {
      sticky: isSticky && !isFixed,
      fixed: isFixed && !isSticky,
      absolute: !isFixed && !isSticky,
    },
    'top-0 z-40 mx-auto w-full flex-none md:border-b border-gray-50/0 bg-none transition-opacity ease-in-out',
    'lg:px-5',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <!-- Gradiente de fundo verde (apenas mobile) -->
  <div
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute inset-0 h-full',
      {
        'md:hidden bg-linear-to-b from-agua-primary-blue from-0% via-agua-primary-blue/95 via-70% to-transparent':
          !isHome,
      },
      { 'bg-black/30': isHome },
    ]}
  >
  </div>

  <!-- CONTAINER PRINCIPAL - Organiza todo o conteúdo do header -->
  <div
    class:list={[
      'text-default relative mx-auto w-full p-4 md:px-6',
      'md:flex md:justify-between max-w-7xl',
      { 'border-b-2 border-gray-200': !isHome },
    ]}
  >
    <!-- SEÇÃO 1 MOBILE: Logo + Botão Menu Mobile (esquerda) -->
    <!--  -->
    <div class:list={['flex justify-between']}>
      <!-- Logo clicável que leva pra home -->
      <a
        class="flex w-fit items-center rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        href={getHomePermalink()}
        aria-label="Água Mineral São Geraldo — Página inicial"
      >
        <Logo />
      </a>

      <!-- Botão hamburguer (só aparece no mobile) -->
      <div class="flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>

    <!-- SEÇÃO 2: Menu de Navegação (centro) - Escondido no mobile -->
    <nav id="main-navigation" class="hidden w-auto gap-3 md:flex" aria-label="Navegação Principal">
      <!-- Lista de itens do menu -->
      <ul
        class="flex w-full flex-col text-xl font-medium tracking-[0.01rem] md:w-auto md:flex-row md:justify-center md:self-center md:text-[0.9375rem]"
      >
        {
          links.map(({ text, href, links: subLinks }, index) => {
            const { triggerId, menuId } = getDropdownIds(text, index);
            return (
              <li
                class={subLinks?.length ? 'dropdown relative' : ''}
                {...(subLinks?.length ? { 'data-aw-dropdown': true } : {})}
              >
                {/* Se o link tem sub-links, cria um dropdown */}
                {subLinks?.length ? (
                  <>
                    {/* Botão do dropdown */}
                    <button
                      id={triggerId}
                      type="button"
                      aria-controls={menuId}
                      aria-expanded="false"
                      aria-haspopup="true"
                      data-aw-dropdown-trigger
                      class="hover:text-link flex items-center px-4 py-3 whitespace-nowrap text-white! rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                    >
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        aria-hidden="true"
                        data-aw-dropdown-icon
                        class="ml-0.5 hidden h-3.5 w-3.5 md:inline rtl:mr-0.5 rtl:ml-0"
                      />
                    </button>

                    {/* Submenu que aparece ao clicar/hover */}
                    <ul
                      id={menuId}
                      aria-hidden="true"
                      aria-labelledby={triggerId}
                      data-aw-dropdown-menu
                      class="dropdown-menu rounded pl-4 font-medium drop-shadow-xl md:absolute md:hidden md:min-w-[200px] md:bg-white/95 md:pl-0 md:backdrop-blur-md"
                    >
                      {subLinks.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'hover:text-link whitespace-no-wrap block px-5 py-2 text-white! md:text-agua-primary-blue! first:rounded-t last:rounded-b focus-visible:outline-2 focus-visible:outline-offset-2',
                              {
                                'text-agua-primary-green! font-bold': href2 === currentPath,
                              },
                            ]}
                            href={href2}
                            aria-current={href2 === currentPath ? 'page' : undefined}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  /* Se não tem sub-links, cria um link simples */
                  <a
                    href={href}
                    aria-current={shouldUnderline(href || '') ? 'page' : undefined}
                    class:list={[
                      // base
                      'flex items-center px-4 py-3 whitespace-nowrap hover:text-link rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2',
                      // cor baseada na página + link
                      {
                        'text-agua-primary-green! focus-visible:outline-white':
                          isHome && shouldUnderline(href || ''),
                        'text-white! focus-visible:outline-white':
                          isHome && !shouldUnderline(href || ''),
                        'text-agua-primary-blue! focus-visible:outline-agua-primary-blue': !isHome,
                      },
                      // estado ativo (apenas underline)
                      {
                        'underline! underline-offset-8! decoration-2! decoration-agua-primary-green!':
                          shouldUnderline(href || ''),
                      },
                    ]}
                  >
                    {text}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
      <!-- Ações -->
      <div class="flex items-center">
        {
          actions?.length ? (
            <div class="flex items-center justify-between gap-5">
              {actions.map((btnProps) => (
                <Button
                  {...btnProps}
                  class={twMerge(
                    'mt-0! max-h-[52px] max-w-[206px] py-2 text-sm font-semibold normal-case md:px-2 lg:px-3',
                    // 'bg-agua-secondary-blue md:bg-transparent',
                    btnProps.class,
                  )}
                />
              ))}
            </div>
          ) : (
            ''
          )
        }
      </div>
    </nav>
  </div>
</header>
