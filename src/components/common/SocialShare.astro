---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
---

<div class={className}>
  <span class="align-super font-bold text-slate-600">Compartilhe:</span>
  <button
    type="button"
    class="ml-2 inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg text-gray-600 transition-colors hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-agua-primary-blue rtl:mr-2 rtl:ml-0"
    title="Compartilhar no X (Twitter)"
    aria-label="Compartilhar no X (Twitter)"
    data-aw-social-share="twitter"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-x" aria-hidden="true" class="h-6 w-6" />
  </button>
  <button
    type="button"
    class="ml-2 inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg text-gray-600 transition-colors hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-agua-primary-blue rtl:mr-2 rtl:ml-0"
    title="Compartilhar no Facebook"
    aria-label="Compartilhar no Facebook"
    data-aw-social-share="facebook"
    data-aw-url={url}
    ><Icon name="tabler:brand-facebook" aria-hidden="true" class="h-6 w-6" />
  </button>
  <button
    type="button"
    class="ml-2 inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg text-gray-600 transition-colors hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-agua-primary-blue rtl:mr-2 rtl:ml-0"
    title="Compartilhar no LinkedIn"
    aria-label="Compartilhar no LinkedIn"
    data-aw-social-share="linkedin"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-linkedin" aria-hidden="true" class="h-6 w-6" />
  </button>
  <button
    type="button"
    class="ml-2 inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg text-gray-600 transition-colors hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-agua-primary-blue rtl:mr-2 rtl:ml-0"
    title="Compartilhar no WhatsApp"
    aria-label="Compartilhar no WhatsApp"
    data-aw-social-share="whatsapp"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-whatsapp" aria-hidden="true" class="h-6 w-6" />
  </button>
  <button
    type="button"
    class="ml-2 inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg text-gray-600 transition-colors hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-agua-primary-blue rtl:mr-2 rtl:ml-0"
    title="Compartilhar por e-mail"
    aria-label="Compartilhar por e-mail"
    data-aw-social-share="mail"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:mail" aria-hidden="true" class="h-6 w-6" />
  </button>
</div>
